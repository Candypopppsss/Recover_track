{
  "name": "recovertrack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node --watch server/index.mjs",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node scripts/dev.mjs --production",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
    "check:secrets": "node scripts/check-secrets.mjs --dist",
    "configure:vercel": "node scripts/configure-vercel.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.0",
    "lucide-react": "^0.468.0",
    "recharts": "^3.1.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.1.0",
    "cookie-parser": "^1.4.7",
    "multer": "^2.0.2",
    "zod": "^4.1.0",
    "mongodb": "^6.19.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "vite": "^7.1.5",
    "typescript": "~5.9.2",
    "@playwright/test": "^1.55.0",
    "supertest": "^7.1.4"
  }
}
